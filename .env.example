# 复制为 .env.prod 后填写；.env* 不进 git
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///demo.db

# ---- qqbot_ai：AI 问答（喊「小e」提问）----
# 任何 OpenAI 兼容接口都行：DeepSeek / OpenAI / 通义 / Moonshot / OneAPI / Ollama
qqbot_ai_api_base=https://api.deepseek.com/v1
qqbot_ai_api_key=
qqbot_ai_model=deepseek-chat
# 回复字数上限 & 输出 token 上限
qqbot_ai_max_reply_chars=180
qqbot_ai_max_output_tokens=512
# 输入压缩
qqbot_ai_max_input_chars=500
qqbot_ai_max_context_chars=1500
# 拦截词：提问命中直接拒答，不打模型
# qqbot_ai_blocked_keywords=偷拍,未成年
# 输出违禁词：模型输出命中即整段替换
# qqbot_ai_forbidden_words=
# 工具：需要 pip install ddgs
qqbot_ai_tools_enabled=true
qqbot_ai_search_backend=auto
# 汇率换算工具：问「2500日元是多少人民币」时查实时汇率
qqbot_ai_currency_enabled=true
# 唤醒词
# qqbot_ai_wake_words=["小e"]
# 冷却
qqbot_ai_cooldown_seconds=5

# 连续对话：shared（整群共用）/ user（每人只接自己上一问）
qqbot_ai_history_mode=shared
qqbot_ai_history_turns=6
qqbot_ai_history_expire_minutes=30
