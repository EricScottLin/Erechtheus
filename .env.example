# ============================================================
#  QQ Bot 统一环境变量  —  模板文件
#  用法：cp .env.example .env && 按注释填写
#  真实 .env 含密钥，已被 .gitignore 忽略，绝不提交
# ============================================================

# ---------- LLBot 接入层 ----------
# LLBot Docker 镜像（官方仓库 LLOneBot/LuckyLilliaBot，Docker Hub linyuchen/llbot）
LLBOT_IMAGE=linyuchen/llbot:8.3.2

# 登录用 QQ 小号（必填）。留空则 LLBot 起在 WebUI 登录页，扫码/点选账号登录。
# 填了之后：重启自动恢复该号登录（免扫码），且 LLBot 会读写 llbot-data/config_<该QQ>.json
LLBOT_QQ=在此填QQ号

# LuckyLillia Auth Token（必填！无它无头模式永远登不上）
# 获取：https://auth.luckylillia.com （需 GitHub OAuth / 微信登录后申请，人工审核）
# 也可在 WebUI 登录页录入，或写入 llbot-data/auth_token.txt
LLBOT_AUTH_TOKEN=在此填JWT

# WebUI 监听地址与端口。host 固定 127.0.0.1 —— 只监听回环，
# 远程管理用 SSH 隧道，绝不开公网端口（这是硬性安全要求）。
# 注意 3080 常被其他服务占用，默认改用 3081。
LLBOT_WEBUI_HOST=127.0.0.1
LLBOT_WEBUI_PORT=3081
# WebUI 登录口令
LLBOT_WEBUI_TOKEN=在此填随机口令

# OneBot v11 正向 WebSocket 服务端
# host 固定 127.0.0.1 —— 只监听回环，公网不可达（配合 Docker host 网络模式）
LLBOT_OB11_WS_HOST=127.0.0.1
LLBOT_OB11_WS_PORT=3001
# 强随机 access token（与 NoneBot 侧必须一致）
# 生成：openssl rand -hex 32
LLBOT_OB11_ACCESS_TOKEN=在此填64位随机hex

# LLBot 持久化数据目录（宿主机 bind mount，容器重建/换镜像都不丢登录态）
LLBOT_DATA_DIR=/srv/qqbot/llbot-data

# ---------- NoneBot2 业务层 ----------
# NoneBot2 作为 WS 客户端连 LLBot。
# host 网络模式下两个容器共享宿主机网络栈，127.0.0.1 即对方
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=3001
ONEBOT_ACCESS_TOKEN=与LLBOT_OB11_ACCESS_TOKEN相同

# NoneBot 内置 HTTP 服务（fastapi driver）监听地址。
# bilibili 插件依赖 fastapi/uvicorn，故启用 ~fastapi。
# host 固定 127.0.0.1 —— 只监听回环，公网不可达。
NONE_HOST=127.0.0.1
NONE_PORT=8080
# NoneBot 环境标识：prod 时读取 .env.prod（缺省回退 .env）
ENVIRONMENT=prod

# 超级用户（机器人管理员 QQ 号），可留空
# 注意：NoneBot 按 JSON 解析该值，空串会报 SettingsError。
# 不用时请注释掉整行，不要留 SUPERUSERS= 空值。示例：SUPERUSERS=["123456789"]
# SUPERUSERS=

# ---------- B站账号（可选） ----------
# 想让「y 720p / y 1080p」生效，需要填 B站账号的 SESSDATA：
#   浏览器登录 bilibili.com → F12 → Application → Cookies → 复制 SESSDATA 的值
# 普通账号解锁 720P；1080P 通常需要大会员。不填也能用，最高 480P。
# 三种写法都认：纯值 / SESSDATA=值 / 整段 Cookie（SESSDATA=..; bili_jct=..; DedeUserID=..）
BILI_SESSDATA=

# ---------- B站视频发送（nonebot_plugin_bilibili） ----------
# 群里发B站链接 → 回「y」→ 下载压缩后把视频发到群里
BILI_VIDEO_ENABLE=1
# 群里不用 @ 也自动响应链接（0=必须@机器人）
BILI_VIDEO_AUTO=1
# 只在这些群自动响应（逗号分隔；留空=所有群）
BILI_VIDEO_GROUPS=
# 先回信息卡、等用户回 y 确认（0=直接下载发送）
BILI_VIDEO_CONFIRM=1
# 超过这个时长（秒）不发（1800=30 分钟）
BILI_VIDEO_MAX_DURATION=1800
# 480P 压缩后的体积上限（MB）。长视频会自动放宽（最低码率摆在那），短视频不受影响
BILI_VIDEO_MAX_MB=20
# 压缩后最大高度（px）。想更快可设 360（画质换速度，下载/上传都少一半）
BILI_VIDEO_HEIGHT=480
# 压缩质量（CRF，越大越糊越小）
BILI_VIDEO_CRF=30
# 下载源画质（64=720P，32=480P）
BILI_VIDEO_QN=64
# 确认有效期（秒）
BILI_VIDEO_TTL=600

# ---------- 部署 ----------
COMPOSE_PROJECT_NAME=qqbot
TZ=Asia/Shanghai
