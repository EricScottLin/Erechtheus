# ============================================================
#  密钥与运行时状态 —— 绝不入 Git
# ============================================================
# .env 含 LLBot Auth Token(JWT)、WebUI Token、OB11 Access Token
.env
# .env.prod 含 ONEBOT_ACCESS_TOKEN
.env.*
# 但保留示例文件，供他人按模板配置
!.env.example
!.env.prod.example

# LLBot 持久化数据：QQ 登录态 / session / auth_token.txt / 日志 / 数据库
# 属机器本地状态，且含凭证
llbot-data/
*.bak.*

# 插件运行时数据（localstore：签到记录、金币、捕鱼进度）
/data/

# ============================================================
#  大体积二进制资源（不入 Git，按 README 指引下载）
# ============================================================
# 舞萌DX 静态资源，解压后约 491M（对应 MAIMAIDX_PATH=/static）
maimaidx-static/
# 资源包下载源，约 446M
static-src/
# 通用大文件兜底
*.7z
*.zip
*.tar.gz

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
#  nb-cli / NoneBot
# ============================================================
.nb/

