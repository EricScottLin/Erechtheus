# ============================================================
#  NoneBot 生产环境配置  —  模板文件
#  用法：cp .env.prod.example .env.prod && 填写 Token
#  真实 .env.prod 含 ONEBOT_ACCESS_TOKEN，已被 .gitignore 忽略
#
#  优先级说明：NoneBot 中 .env.prod 的值**高于**容器环境变量
#  （deep_update(env_settings(), init_settings())），
#  所以适配器连接参数必须写在这里，写在 compose 的 environment 里会被覆盖。
# ============================================================

# 驱动：fastapi 提供 HTTP 服务（bilibili 插件依赖），
# + websockets 提供 WebSocket 客户端能力（OneBot 适配器作为 WS 客户端必需）。
# 单独用 ~fastapi 只有 ASGIMixin，没有 WebSocketClientMixin，
# 会导致适配器日志告警 "does not support websocket client connections! Ignored" 而连不上。
DRIVER=~fastapi+~websockets

# localstore 数据目录设为当前工作目录下（容器内 /app/data，
# 由 docker-compose 挂载 ./data 持久化）
LOCALSTORE_USE_CWD=true

# ---------- 连接 LLBot 的 OneBot v11 正向 WebSocket ----------
# NoneBot2 作为 WS 客户端，连 LLBot 的 ws://127.0.0.1:3001
# host 网络模式下两个容器共享宿主机网络栈，127.0.0.1 即 LLBot
#
# 注意：适配器只认 ONEBOT_WS_URLS（完整 URL 的 JSON 数组），
# 不存在 ONEBOT_WS_HOST / ONEBOT_WS_PORT 这两个配置项，写了会被忽略。
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# 必须与 LLBot 侧 llbot-data/config_<QQ>.json 里的 ob11.connect[].token 完全一致
ONEBOT_ACCESS_TOKEN=在此填64位随机hex

# ---------- NoneBot 内置 HTTP 服务（fastapi driver）----------
# 只监听回环；bilibili 插件依赖 fastapi/uvicorn 故启用
HOST=127.0.0.1
PORT=8080

# ---------- 舞萌DX查分插件 nonebot-plugin-maimaidx ----------
# 静态资源目录（容器内 /static，宿主机对应 ./maimaidx-static/static），
# 必须存在且含 font/mai/data。资源包下载见插件 README。
# 注意：必须可写（rw）—— 插件把可变状态（user.db、群开关、别名缓存）
# 放在 static/data 下，挂成 ro 会报 sqlite3.OperationalError。
MAIMAIDX_PATH=/static
MAIMAIDX_ALIAS_PUSH=true
MAIMAIDX_ALIAS_PROXY=false
SAVE_IN_MEMORY=true
ASSETS_ONLINE=true

# ---------- 水鱼查分器（diving-fish）OAuth ----------
# 必填，否则 b50 / 牌子完成表 / 进度 / info 等「按 QQ 查成绩」的指令全部失败，
# 用户会收到「请联系BOT管理员检查水鱼查分器相关信息，暂时无法查询」。
# 原因：插件请求水鱼返回 400 {"msg":"请先联系水鱼申请开发者token"}，
# 被解成 DivingFishTokenNotFoundError。
#
# 申请：登录 https://auth.diving-fish.com/apps 创建 OAuth 应用，拿到应用 ID 与秘钥。
# 权限至少要勾「读取玩家资料」+「读取成绩」，与下面的 SCOPE 对应。
# 旧版 DIVINGFISH_TOKEN（开发者 token）水鱼已停止签发，勿再使用。
DIVINGFISH_CLIENT_ID=
DIVINGFISH_CLIENT_SECRET=
DIVINGFISH_SCOPE=prober.profile.read prober.records.read
# DIVINGFISH_AUTH_URL=https://auth.diving-fish.com
# 境外服务器可以走插件作者的中转（会丢失上报客户 IP，不影响鉴权）
# DIVINGFISH_PROBER_PROXY=false

# ---------- 超级用户（机器人管理员 QQ 号），多个用空格分隔 ----------
# 注意：NoneBot 会按 JSON 解析该值，空串会报 SettingsError。
# 不用时请注释掉整行，不要留 SUPERUSERS= 空值。示例：SUPERUSERS=["123456789"]
# SUPERUSERS=

# ---------- 群聊管理插件 qqbot_group ----------
# /烟 随机禁言时长区间（秒），上限 28800 = 8 小时
# qqbot_group_smoke_min_seconds=60
# qqbot_group_smoke_max_seconds=28800
# /禁言 未指定时长时的默认禁言（秒），默认 600 = 10 分钟
# qqbot_group_ban_default_seconds=600
# 额外允许使用群管命令的 QQ 号（除群主/群管/SUPERUSERS 之外，逗号分隔）
# qqbot_group_extra_admins=123456,789012
# 复读：连续相同文本达到 times 条时复读，cooldown 秒内不重复
# qqbot_group_repeat_enabled=true
# qqbot_group_repeat_include_images=true
# qqbot_group_repeat_times=3
# qqbot_group_repeat_cooldown=60
# qqbot_group_repeat_max_len=200

# ---------- 货币/个人信息基础插件 qqbot_core ----------
# /爆金币 白名单（SUPERUSERS 之外可直接发币的 QQ 号，JSON 数组）
# qqbot_core_whitelist=["123456","789012"]
# 每个代币的日获取上限（防刷，JSON 对象；不填用默认 kleos=680 / drachma=5000）
# qqbot_core_daily_earn_cap={"kleos":680,"drachma":5000}
# /领金币 活动默认开关（建议保持 false，需要时 bot 主私聊 /活动开关 on）
# qqbot_core_claim_enabled=false
# 群等级 → 月币发放档位（JSON 对象，取不超过等级的最高档）
# qqbot_core_claim_tiers={"1":100,"20":300,"50":600,"100":1000}
# 跨群加成：每多一个共同群 +10%，封顶 +30%（按共同群的最高等级算档位）
# qqbot_core_claim_multi_group_bonus=0.10
# qqbot_core_claim_multi_group_bonus_cap=0.30


# ---------- 帮助菜单（picmenu-next / htmlrender） ----------
# htmlrender 0.7 默认懒启动，首次出图会很慢；指定 Playwright 后端并在启动时探活
RENDER_BACKEND=playwright
RENDER_STARTUP_MODE=probe

# ---------- 表情包管理插件 qqbot_meme ----------
# 戳一戳随机回图 / 冷却秒数 / 单文件大小上限（MB）
# qqbot_meme_poke_enabled=true
# qqbot_meme_poke_cooldown=3
# qqbot_meme_max_mb=5
# qqbot_meme_quote_enabled=true
# 群精华自动收录：开关与轮询间隔（秒）
# qqbot_meme_essence_sync=true
# qqbot_meme_essence_interval=60
# 戳一戳抽取权重：图片（本地+外部表情库） : 金句
# qqbot_meme_poke_image_weight=3
# qqbot_meme_poke_quote_weight=1
# 来源加权：count=按各来源库大小加权（推荐），uniform=每个来源等概率
# qqbot_meme_source_weighting=count
